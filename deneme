from itertools import product
from random import randint

def create_count_list(n):
    S = []
    for i in range(n):
        S.append(randint(1,n))
    return S

def direct_add(S,prev_min,remaining):
    total = 0
    for val in S:
        current_min = min(prev_min,val)
        if(remaining == 1):
            res = current_min
        else:
            res = direct_add(S,current_min,remaining-1)
        total += res
    return total
    
